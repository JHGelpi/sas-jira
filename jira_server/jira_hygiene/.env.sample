# ==============================================================================
# JIRA AUTOMATION - SAMPLE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your actual values
# ==============================================================================

# ------------------------------------------------------------------------------
# Postgres Database Details
# ------------------------------------------------------------------------------
# Your local postgres connection details

# Host name for your database.  I used localhost
DB_HOST=

# Postgres user that has the necessary permissions to query, update, modify, and create tables
DB_USER=

# Postgres user database
DB_PASSWORD=

# Postgres database name
DB_NAME=

# Postgres DB port
DB_PORT=

# Postgres DB timeout duration
DB_CONN_TIMEOUT=10

# Postgres connection string
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:{DB_PORT}/{DB_NAME}

# ------------------------------------------------------------------------------
# Jira Connection Settings (REQUIRED)
# ------------------------------------------------------------------------------
# Your Jira server URL
JIRA_URL=https://your-jira-instance.com/

# Jira Personal Access Token (PAT) or API token
# To create a PAT in Jira:
# 1. Go to your Jira profile settings
# 2. Navigate to "Personal Access Tokens"
# 3. Create a new token with appropriate permissions
JIRA_TOKEN=your_jira_personal_access_token_here

# ------------------------------------------------------------------------------
# Stale Issue Detection (REQUIRED for update_stale_issues function)
# ------------------------------------------------------------------------------
# JQL query to find issues that have been inactive for a long time
# Example: Find bugs not updated in 6+ months
# Sample JQL: project in (YOUR_PROJECT) AND type = Bug AND statusCategory != Done AND updatedDate <= endOfDay(-185) AND labels != icebox-ignore
JQL_QUERY=

# Label to add to stale issues
LABEL_TO_ADD=

# Comment to add to stale issues (supports \n for newlines)
# Sample comment:
# ***THIS IS AN AUTOMATED MESSAGE***\n\nThis issue has not been updated in over 6 months. It has been marked as stale and may be subject to closure. If you believe this bug is still relevant and required please remove the 'compdiv-icebox' label and leave a comment with your business reason. Thank you.
COMMENT_TO_ADD=

# ------------------------------------------------------------------------------
# Icebox Issue Closure (REQUIRED for close_icebox_issues function)
# ------------------------------------------------------------------------------
# JQL query to find icebox issues that should be closed
# Example: Find bugs with icebox label not updated in 30+ days
# Sample JQL: project in (YOUR_PROJECT) AND labels = compdiv-icebox AND statusCategory != Done AND type = Bug AND updatedDate <= endOfDay(-30)
JQL_QUERY_ICEBOX=

# Comment to add when closing icebox issues (supports \n for newlines)
# SAMPLE COMMENT:
# ***THIS IS AN AUTOMATED MESSAGE***\n\nThis issue has not been updated in over 30 days and has the 'compdiv-icebox' label. It has therefore been closed out. If you need this bug reopened, please create a ticket and reference this issue. Thank you.
COMMENT_TO_ADD_ICEBOX=

# ------------------------------------------------------------------------------
# Optional Icebox Closure Settings
# ------------------------------------------------------------------------------
# Specific Fix Version to use when closing issues (if fixVersions field is required)
# If not set, the script will try to find a version matching keywords:
# 'not planned', 'unscheduled', 'icebox', 'wont fix', "won't fix"
# Example: JIRA_ICEBOX_FIX_VERSION=Not Planned
JIRA_ICEBOX_FIX_VERSION=

# Value for "Doc Needed" custom field when closing issues (default: No)
# Only applies if the field exists and is available during the transition
JIRA_ICEBOX_DOC_NEEDED_VALUE=No

# ------------------------------------------------------------------------------
# Logging Configuration (OPTIONAL)
# ------------------------------------------------------------------------------
# Enable emoji in log output (true/false, default: true)
LOG_USE_EMOJI=true

# Enable ANSI colors in terminal output (true/false, default: false)
LOG_USE_COLORS=false
